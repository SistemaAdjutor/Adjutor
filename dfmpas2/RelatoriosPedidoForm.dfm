      #9'MMO.MMO_TOLERANCIA_ABERT_GANCHO_MAX,'
      #9'MMO.MMO_TOLERANCIA_ABERT_GANCHO_MIN,'
      #9'MMO.MMO_COMP_GANCHO,'
      #9'MMO.MMO_DIAMETRO_EXT_MAIOR,'
      #9'MMO.MMO_DIAMETRO_EXT_MENOR,'
      #9'MMO.MMO_PERDA,'
      #9'MMO.MMO_TOLERANCIA_DE_MAIOR_MIN,'
      #9'MMO.MMO_TOLERANCIA_DE_MAIOR_MAX,'
      #9'MMO.MMO_TOLERANCIA_DE_MENOR_MIN,'
      #9'MMO.MMO_TOLERANCIA_DE_MENOR_MAX,'
      #9'MMO.MMO_TOLERANCIA_COMP_GANCHO_MAX,'
      #9'MMO.MMO_TOLERANCIA_COMP_GANCHO_MIN,'
      #9'ARA.NOME AS ARA_NOME,'
      #9'ART.ART_NOME,'
      #9'CMO_NOME,'
      #9'TSU.TSU_NOME,'
      #9'ASU.ASU_NOME,'
      #9'ACO.ACO_NOME,'
      #9'PRD.PRD_DESCRI,'
      #9'PRD.PRD_REFER,'
      #9'IT.PRF_QTDE,'
      #9'GA.GAN_NOME,'
      #9'TP.TEM_DESCRICAO'
      'FROM'
      #9'MOLA_MATERIA MMO'
      'LEFT JOIN ARAME ARA ON'
      #9'(ARA.ARA_CODIGO = MMO.ARA_CODIGO)'
      'LEFT JOIN ARTEFATO ART ON'
      #9'(ART.ART_CODIGO = MMO.ART_CODIGO)'
      'LEFT JOIN CLASSIFICACAO_MOLA CMO ON'
      #9'(CMO.CMO_CODIGO = MMO.CMO_CODIGO)'
      'LEFT JOIN TRATAMENTO_SUPERFICIAL TSU ON'
      #9'(TSU.TSU_CODIGO = MMO.TSU_CODIGO)'
      'LEFT JOIN ACABAMENTO_SUPERFICIAL ASU ON'
      #9'(ASU.ASU_CODIGO = MMO.ASU_CODIGO)'
      'LEFT JOIN ACABAMENTO_CORES ACO ON'
      #9'(ACO.ACO_CODIGO = MMO.ACO_CODIGO)'
      'LEFT JOIN GANCHO GA ON'
      #9'(GA.GAN_CODIGO = MMO.GAN_CODIGO)'
      'JOIN PRD0000 PRD ON'
      #9'(PRD.PRD_CODIGO = MMO.PRD_CODIGO)'
      'JOIN PED_IT01 IT ON'
      #9'(IT.PRD_REFER = PRD.PRD_REFER'
      #9#9'AND IT.PED_CODIGO = '#39'012075'#39')'
      'JOIN PED0000 pd ON'
      #9'(pd.ped_codigo = IT.PED_CODIGO)'
      'JOIN TIPO_MOLA TM ON'
      #9'(TM.PTI_CODIGO = PRD.PTI_CODIGO)'
      'LEFT JOIN TIPO_EMBALAGEM TP ON'
      #9'(TP.TEM_CODIGO = MMO.TEM_CODIGO)'
      'LEFT JOIN ORDEMPRODUCAO op ON'
      #9'(op.PED_CODIGO = it.PED_CODIGO)'
      'LEFT JOIN ITEM_ORDEMPRODUCAO iop ON'
      #9'(ioP.OPR_CODIGO = op.OPR_CODIGO'
      #9#9'AND IT.PRD_REFER = PRD.PRD_REFER'
      #9#9'AND iop.PRf_REGISTRO = it.PRf_REGISTRO)'
      'WHERE'
      #9'MMO.PRD_CODIGO IN ('
      #9'SELECT'
      #9#9'prd_codigo'
      #9'FROM'
      #9#9'PRD0000 PRD'
      #9'JOIN prd_tipo TI ON'
      #9#9'(PRD.PTI_CODIGO = TI.PTI_CODIGO)'
      #9'WHERE'
      #9#9'TI.PTI_SIGLA = '#39'PA'#39
      #9#9'AND PRD.PRD_REFER IN ('
      #9#9'SELECT'
      #9#9#9'PRD_REFER'
      #9#9'FROM'
      #9#9#9'ped_it01'
      #9#9'WHERE'
      #9#9#9'PED_CODIGO = '#39'012075'#39'))'
      'ORDER BY'
      #9'it.PRF_SEQUENCIA')
    SQLConnection = DBConn
    Left = 696
    Top = 224
  end
