  object qMola: TSQLQuery
    MaxBlobSize = 1
    Params = <>
    SQL.Strings = (
      'SELECT'
      #9'it.PRF_SEQUENCIA,'
      #9'pd.ped_codigo,'
      #9'pd.emp_codigo,'
      #9'it.PRDCO_CODIGO_ORIGINAL AS PRD_CODORIGINAL,'
      #9'iop.IOP_NORDEM,'
      #9'tm.MMO_TIPO,'
      #9'tm.MMO_VARIACAO,'
      #9'CAST(CASE'
      #9#9'PRF_PRODUTO_AGREGADO WHEN '#39'N'#39' THEN it.PRF_REGISTRO'
      
        #9#9'WHEN '#39'S'#39' THEN it.prf_registro_vinculado || '#39'.'#39' || it.PRF_REGIS' +
        'TRO'
      #9'END AS NUMERIC(14,'
      #9'8)) PRF_REGISTRO,'
      #9'it.prf_registro AS registro,'
      #9'CASE'
      
        #9#9'WHEN IT.PRF_PRAZO_ENTREGA IS NULL THEN CAST(pd.PED_DTSAIDA AS ' +
        'date)'
      #9#9'ELSE IT.PRF_PRAZO_ENTREGA'
      #9'END AS PRF_PRAZO_ENTREGA,'
      #9'MMO.MMO_ARQUIVO_FICHA_TECNICA,'
      #9'TM.MMO_DIAMETRO_INT_MAIOR TM_DIAMETRO_INT_MAIOR,'
      #9'TM.MMO_DIAMETRO_INT_MENOR TM_DIAMETRO_INT_MENOR,'
      #9'MMO.MMO_DIAMETRO_INT_MAIOR,'
      #9'MMO.MMO_TOLERANCIA_DI_MAIOR_MAX,'
      #9'MMO.MMO_TOLERANCIA_DI_MAIOR_MIN,'
      #9'MMO.MMO_DIAMETRO_INT_MENOR,'
      #9'MMO.MMO_TOLERANCIA_DI_MENOR_MAX,'
      #9'MMO.MMO_TOLERANCIA_DI_MENOR_MIN,'
      #9'TM.MMO_DIAMETRO_ARAME TM_DIAMETRO_ARAME,'
      #9'TM.MMO_DIAMETRO_INTERNO TM_DIAMETRO_INTERNO,'
      #9'TM.MMO_DIAMETRO_MEDIO TM_DIAMETRO_MEDIO,'
      #9'TM.MMO_DIAMETRO_EXTERNO TM_DIAMETRO_EXTERNO,'
      #9'TM.MMO_DIAMETRO_EXTERNO_MEIO TM_DIAMETRO_EXTERNO_MEIO,'
      #9'TM.MMO_DIAMETRO_EXT_MAIOR TM_DIAMETRO_EXT_MAIOR,'
      #9'TM.MMO_DIAMETRO_EXT_MENOR TM_DIAMETRO_EXT_MENOR,'
      #9'TM.MMO_PASSO TM_PASSO,'
      #9'TM.MMO_COM_LIVRE TM_COM_LIVRE,'
      #9'TM.MMO_COMP_CORPO TM_COMP_CORPO,'
      #9'TM.MMO_ALT_GANCHO TM_ALT_GANCHO,'
      #9'TM.MMO_ABERT_GANCHO TM_ABERT_GANCHO,'
      #9'TM.MMO_COMP_GANCHO TM_COMP_GANCHO,'
      #9'TM.MMO_DESENVOLVIMENTO TM_DESENVOLVIMENTO,'
      #9'TM.MMO_ESPIRAIS_UTEIS TM_ESPIRAIS_UTEIS,'
      #9'TM.MMO_ESPIRAL_TOTAL TM_ESPIRAL_TOTAL,'
      #9'TM.MMO_SENTIDO TM_SENTIDO,'
      #9'TM.MMO_PESO TM_PESO,'
      #9'TM.MMO_MAQUINA TM_MAQUINA,'
      #9'TM.MMO_MANDRIL TM_MANDRIL,'
      #9'TM.MMO_CACHIMBO TM_CACHIMBO,'
      #9'TM.MMO_COPIADOR TM_COPIADOR,'
      #9'TM.MMO_GANCHO TM_GANCHO,'
      #9'TM.MMO_DISCO TM_DISCO,'
      #9'TM.MMO_OUTROS TM_OUTROS,'
      #9'TM.MMO_TIPOEMBALAGEM TM_TIPOEMBALAGEM,'
      #9'TM.MMO_LOCALIZACAO TM_LOCALIZACAO,'
      #9'TM.MMO_SETOR TM_SETOR,'
      #9'TM.MMO_VAO TM_VAO,'
      #9'MMO.MMO_CODIGO,'
      #9'MMO.PRD_CODIGO,'
      #9'MMO.ART_CODIGO,'
      #9'MMO.ARA_CODIGO,'
      #9'MMO.CMO_CODIGO,'
      #9'MMO.GAN_CODIGO,'
      #9'MMO.ACO_CODIGO,'
      #9'MMO.ASU_CODIGO,'
      #9'MMO.TSU_CODIGO,'
      #9'MMO.MMO_TEMPO_PRODUCAO,'
      #9'MMO.MMO_PESO_ESPECIFICO,'
      #9'MMO.MMO_CISALHAMENTO,'
      #9'MMO.MMO_RES_TRACAO,'
      #9'MMO.MMO_TRATAMENTO_TERMICO,'
      #9'MMO.MMO_TEMPO_TEMPERA,'
      #9'MMO.MMO_TEMPERATURA_TEMPERA,'
      #9'MMO.MMO_TEMPO_REVENIMENTO,'
      #9'MMO.MMO_TEMPERATURA_REVENIMENTO,'
      #9'MMO.MMO_DUREZA_MINIMA,'
      #9'MMO.MMO_DUREZA_MAXIMA,'
      #9'MMO.MMO_TRATAMENTO_SUPERFICIAL,'
