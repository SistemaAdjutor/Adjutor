  object qPedidos: TSQLQuery
    MaxBlobSize = 1
    Params = <>
    SQL.Strings = (
      'SELECT'
      #9'DISTINCT PED.PED_CONTATO_CLIENTE,'
      #9#39#39' AS IOP_NORDEM,'
      #9'PED.PED_CODIGO,'
      #9'PED.PED_DTENTRADA,'
      #9'PED.PED_DTSAIDA,'
      #9'PED.PED_EXPEDICAO,'
      #9'PED.PED_COMIS1,'
      #9'PED.PED_COMIS2,'
      #9'PED.PED_COMIS3,'
      #9'PED.PED_FRETE ,'
      #9'PED.PED_FRETE2,'
      #9'PED.PED_SITCRED,'
      #9'PED.PED_PRIORIDADE,'
      #9'PED.PED_TOTUPS,'
      #9'PED_SUBCABECALHOPPAC,'
      #9'PED.PED_VLTUPS,'
      #9'('
      #9'SELECT'
      #9#9'COALESCE(sum(t1.prf_qtde * t2.prd_pesokg),'
      #9#9'0)'
      #9'FROM'
      #9#9'ped_it01 T1'
      #9'JOIN prd0000 T2 ON'
      #9#9'(t2.prd_refer = t1.prd_refer)'
      #9'WHERE'
      #9#9'T1.ped_codigo = ped.ped_codigo) AS peso,'
      #9'CASE'
      #9#9'WHEN (PED.ENDERECO_ENTREGA > 0) '
      
        '          THEN '#39'ENDERE'#199'O DE ENTREGA: '#39' || ENDER.descricao || '#39' B' +
        'AIRRO: '#39' || COALESCE(ENDER.BAIRRO,'
      #9#9#39#39')|| '#39' CIDADE: '#39' || COALESCE(ENDER.CIDADE,'
      #9#9'CLI.cli_cidade)|| '#39' CEP: '#39' || COALESCE(ENDER.CEP,'
      #9#9#39#39')'
      #9#9'ELSE '#39#39
      #9'END AS CIDADE_ENTREGA,'
      #9'PED.PED_DESCTONF,'
      #9'PED.PED_DESCTOPC1,'
      #9'PED.PED_DESCTOPC2,'
      #9'PED.PED_DESCTOVL,'
      #9'PED.PED_VLTOTAL_LIQ,'
      #9'PED.PED_VLTOTAL_IPI,'
      #9'PED.PED_VLDIFAL,'
      #9'PED.PED_VLTOTAL_BRUTO,'
      #9'CLI.CLI_EMAIL_ALTERNATIVO,'
      #9't4.PMT_MOTIVO,'
      #9'PED.PED_SITUACAO,'
      #9'PED.PED_VLFRETE ,'
      #9'PED.PED_DESP_ACES,'
      #9'PED.PED_OBSERVACAO,'
      #9'PED.PED_VALOR_ST,'
      #9'PED.CLI_CODIGO,'
      #9'CLI.CLI_RAZAO,'
      #9'CLI.CLI_FANTASIA,'
      #9'CLI.CLI_ENDERE,'
      #9'CLI.CLI_BAIRRO,'
      #9'CLI.CLI_CIDADE,'
      #9'CLI.CLI_UF,'
      #9'CLI.CLI_CEP,'
      #9'CLI.CLI_PESSOA,'
      #9'CLI.CLI_CGC,'
      #9'CLI.CLI_INSC,'
      #9'CLI.CLI_CONTATO,'
      #9'CLI.CLI_FONE,'
      #9'CLI.CLI_FAX,'
      #9'CLI.CLI_ENDENTR,'
      #9'CLI.CLI_CIDENTR,'
      #9'CLI.CLI_UFENTR,'
      #9'CLI.CLI_CEPENTR,'
      #9'CLI.CLI_ENDFAT,'
      #9'CLI.CLI_CIDFAT,'
      #9'CLI.CLI_UFFAT,'
      #9'CLI.CLI_CEPFAT,'
      #9'CLI.CLI_EMAIL,'
      #9'PED.REP_CODIGO,'
      #9'REP.REP_NOME,'
      #9'REP.REP_EMAIL,'
      #9'PED.PCL_CODIGO,'
      #9'PCL.PCL_NOME,'
      #9'PED.TRP_CODIGO,'
      #9'TRP.TRP_RAZAO,'
      #9'TRP.TRP_FONE,'
      #9'PED.TRP_REDESP,'
      #9'TRR.TRP_RAZAO,'
      #9'TRR.TRP_FONE,'
      #9'PED.OPV_CODIGO,'
      #9'OPV.OPV_DESCRICAO,'
      #9'ped.PCX_CODIGO,'
      #9'PCX.PCX_DESCRI,'
      #9'PED.PED_PLACA,'
      #9'PED_NUMERO_PED_CLIENTE,'
      #9'FPG_DESCRICAO'
      'FROM'
      #9'PED0000 PED'
      'LEFT JOIN CLI0000 CLI ON'
      #9'PED.cli_codigo = CLI.cli_codigo'
      'LEFT JOIN REP0000 REP ON'
      #9'PED.rep_codigo = REP.rep_codigo'
      'LEFT JOIN PED_MOTIVO t4 ON'
      #9'(t4.PMT_REGISTRO = PED.PMT_REGISTRO)'
      'LEFT JOIN PCL0000 PCL ON'
      #9'PED.pcl_codigo = PCL.pcl_codigo'
      'LEFT JOIN TRP0000 TRP ON'
      #9'PED.trp_codigo = TRP.trp_codigo'
      'LEFT JOIN TRP0000 TRR ON'
      #9'PED.trp_redesp = TRR.trp_codigo'
      'LEFT JOIN OPV0000 OPV ON'
      #9'(OPV.OPV_CODIGO = PED.OPV_CODIGO)'
      'LEFT JOIN ENDERECO ENDER ON'
      #9'ENDER.CODIGO = PED.ENDERECO_ENTREGA'
      'LEFT JOIN PCX0000 PCX ON'
      #9'PCX.PCX_CODIGO = PED.PCX_CODIGO'
      #9'AND PCX.EMP_CODIGO = PED.EMP_CODIGO'
      'LEFT JOIN FORMA_PAGAMENTO FPG ON'
      #9'(FPG.FPG_REGISTRO = PED.FPG_REGISTRO)'
      'LEFT JOIN ORDEMPRODUCAO op ON'
      #9'op.PED_CODIGO = ped.PED_CODIGO'
      'LEFT JOIN ITEM_ORDEMPRODUCAO iop ON'
      #9'iop.OPR_CODIGO = op.OPR_CODIGO'
      'WHERE'
      #9'PED.PED_CODIGO = '#39'012075'#39
      #9'AND ped.emp_codigo = '#39'001'#39
      'ORDER BY'
      #9'PED.PED_CODIGO')
    SQLConnection = DBConn
    Left = 768
    Top = 224
  end
  object qPedidosItem: TSQLQuery
    MaxBlobSize = -1
    Params = <>
    SQL.Strings = (
      
        'Select '#9'CASE    WHEN PIT.PRF_PRAZO_ENTREGA is NULL THEN CAST(pd.' +
        'PED_DTSAIDA AS date)    ELSE  PIT.PRF_PRAZO_ENTREGA  END AS DATA' +
        '_ENTREGA,   cast(CASE PRF_PRODUTO_AGREGADO           WHEN '#39'N'#39' TH' +
        'EN pit.PRF_REGISTRO          WHEN '#39'S'#39' THEN pit.prf_registro_vinc' +
        'ulado|| '#39'.'#39' ||  PRF_REGISTRO     END AS NUMERIC(14,8)) PRF_REGIS' +
        'TRO, prf_registro as registro, '
      
        ' case when (t3.prg_medida_1 > 0.0 and t3.prg_medida_2 > 0.0 and ' +
        't3.prg_medida_3 > 0.0) then cast( cast(t3.prg_medida_1 as real) ' +
        '* cast(t3.prg_medida_2  as real) * cast(t3.prg_medida_3 as real)' +
        ' * cast(pit.prf_qtde as real) as Numeric(18,3) ) else 0 end as M' +
        '3, '
      
        '   case WHEN PRF_REGISTRO_VINCULADO = 0 THEN   (SELECT PRD_REFER' +
        ' FROM pCd_retorna_referencia_item_ped(pit.emp_codigo, pit.prf_re' +
        'gistro)) '
      #9'ELSE prd.prd_refer'#9'END   as REFERENCIA,'
      ' pit.PRF_PRDDESCRI DESCRICAO, '
      ' T44.prdd_sigla ,'
      
        '       case when (PIT.PRD_UND is null) or (PIT.PRD_UND = '#39#39') THE' +
        'N PRD.PRD_UND ELSE PIT.PRD_UND END AS PRD_UND,'
      '       COALESCE(PIT.NCM_CODIGO,PRD.ipi_codigo) AS IPI_CODIGO,'
      ' PRF_QTDE'
      ',PRF_QTDEFAT'
      ',PRF_QTDE_ENV_PRODUCAO'
      ',PRF_QTDE_REC_PRODUCAO'
      ',PRF_PRECO'
      ',PRF_CUSTO'
      ',PRF_PRAZO_ENTREGA'
      ',PRF_MARGEM_PRODUTO'
      ',PRF_IDESCTO1'
      ',PRF_IDESCTO2'
      ',PRF_SITUACAO'
      ',PRF_ITEMCOMIS'
      ',PRF_IPIALIQ'
      ',PRF_ICMSALIQ'
      ',PRF_PRDDESCRI'
      ',PRF_VAR1'
      ',PRF_VAR2'
      ',PRF_VAR3'
      ',PRF_VAR4'
      ',PRF_VAR5'
      ',PRF_VAR6'
      ',PRF_VAR7'
      ',PRF_VAR8'
      ',PRF_PRECO_BRUTO'
      ',PRF_OP'
      ',PRF_QTDE_FAT_VAR1'
      ',PRF_QTDE_FAT_VAR2'
      ',PRF_QTDE_FAT_VAR3'
      ',PRF_QTDE_FAT_VAR4'
      ',PRF_QTDE_FAT_VAR5'
      ',PRF_QTDE_FAT_VAR6'
      ',PRF_QTDE_FAT_VAR7'
      ',PRF_QTDE_FAT_VAR8'
      ',PRF_FLAG_ATUALIZA_ESTOQUE'
      ',PRF_ORIGEM_ITEM'
      ',PRF_PRODUTO_AGREGADO'
      ',PRF_VALOR_ICMS'
      ',USU_CODIGO'
      ',PRF_COMPL_DESCRI'
      ',pit.PRG_REGISTRO'
      ',PRF_PCP_QTDE_ATENDIDA'
      ',PRF_PCP_QTDE_ESTOQUE'
      ',PRF_ACRESCIMO'
      ',PRDL_REGISTRO'
      ',PRF_B2B_PEDIDO_COMPRA'
      ',PRF_B2B_ITEM_PEDIDO_COMPRA'
      ',PRF_VALOR_ST'
      ',pit.OPE_NATUREZA'
      ',ITT_REGISTRO'
      ',pit.PRDD_REGISTRO'
      ',pit.PRF_PRECO_ORIGINAL'
      ',pit.PRF_TABPRECO'
      ',pit.PRDCO_CODIGO_ORIGINAL'
      ',pit.ID_DIRETIVAS'
      ',pit.OPE_CODIGO'
      ',pit.PRD_CODIGO'
      ',pit.AMX_CODIGO_DESTINO'
      ',pit.AMX_CODIGO_ORIGEM'
      ',pit.USOU_VERBA'
      ',pit.VALOR_VERBA'
      ',pit.ped_codigo'
      ',pit.emp_codigo'
      ',pit.prd_refer,'
      ' CASE    '
      
        '    WHEN (PRF_REGISTRO_VINCULADO > 0) and (PRF_PRODUTO_AGREGADO ' +
        '= '#39'S'#39')  THEN (SELECT prf_qtde FROM PED_IT01 WHERE pit.PRF_REGIST' +
        'RO_VINCULADO = PRF_REGISTRO ) * pit.PRF_qtde '
      '    ELSE PRF_qtde  '
      '  END PRF_QTDE_CALC ,'
      '       PTI.PTI_SIGLA,'
      '       t4.lin_descri,'
      '       t5.prde_endereco,'
      '       PRD.PRD_EMBALA,'
      '       PRD.PRD_PESOKG,'
      '       PRD.PRD_PESOLIQ,'
      '       PRD.PRD_DCVAR1,'
      '       PRD.PRD_DCVAR2,'
      '       PRD.PRD_DCVAR3,'
      '       PRD.PRD_DCVAR4,'
      '       PRD.PRD_DCVAR5,'
      '       PRD.PRD_DCVAR6,'
      '       PRD.PRD_DCVAR7,'
      '       PRD.PRD_DCVAR8,'
      '       T3.PRG_INDICE,'
      '       PD.PED_NUMERO_PED_CLIENTE,'
      '       pit.PRF_REGISTRO_VINCULADO, '
      '       cast (pit.PRF_REGISTRO as integer) PRF_REGISTRO, '
      '       PRD_PRODSERV, '
      '       PRF_QTDEPEND, '
      
        ' COALESCE((SELECT SUM(COALESCE(kas_saldo,0)) FROM KARDEX_ALMOX_S' +
        'ALDO KS WHERE PRD_CODIGO = pit.PRD_CODIGO AND pit.AMX_CODIGO_DES' +
        'TINO = KS.AMX_CODIGO),0) ESTOQUE, '
      
        '(SELECT ROUND(PRF_QTDE) FROM PED_IT01 it2 WHERE it2.PRF_REGISTRO' +
        ' = pit.PRF_REGISTRO_VINCULADO) PRF_QTDE_KIT, '
      
        '       CAST ( (prd.prd_pesoliq * pit.prf_qtde) AS NUMERIC(15,5) ' +
        ') As PesoKG, '
      
        '    case PRF_PRAZO_DIAS WHEN NULL THEN '#39#39' WHEN 0 THEN '#39'Imediato'#39 +
        ' when 1 then '#39'1 dia'#39' else cast(PRF_PRAZO_DIAS as varchar(3)) || ' +
        #39' dias'#39' end  || CASE WHEN PRF_QTDEPEND > 0 THEN '#39'*'#39' ELSE '#39#39' END ' +
        'PRF_PRAZO_DIAS , '
      
        '  (CASE WHEN PRF_PESOKG = 0 THEN PRD_PESOliq ELSE PRF_PESOKG END' +
        ')  as PRF_PESOKG '
      'from ped_it01 pit '
      
        '     JOIN PED0000 pd ON pd.PED_CODIGO = pit.PED_CODIGO  AND pd.E' +
        'MP_CODIGO = pit.EMP_CODIGO'
      
        '     left join prd0000 prd on (prd.prd_refer = IIF(Coalesce(pit.' +
        'prd_refer,'#39#39')='#39#39',pit.prdco_codigo_original,pit.prd_refer) )'
      '     left join prd_tipo pti on (prd.pti_codigo = pti.pti_codigo)'
      
        '     left join prd_grade t3 on (t3.prg_registro = pit.prg_regist' +
        'ro) '
      
        '     left join prd_diretiva t44 on (t44.prdd_registro = pit.prdd' +
        '_registro)'
      '     left join prd_linha t4 on (t4.lin_codigo = prd.lin_codigo)'
      
        '     left join prd0000_enderecamento t5 on (t5.prde_registro = p' +
        'rd.prde_registro)'
      'where PIT.PED_CODIGO = '#39'012075'#39'  and PIT.emp_codigo='#39'001'#39' '
      ' AND pTI.PTI_SIGLA = '#39'PA'#39
      'ORDER BY pit.PRF_SEQUENCIA')
    SQLConnection = DBConn
    Left = 608
    Top = 224
  end
  object dspPedidosItem: TDataSetProvider
    DataSet = qPedidosItem
    Left = 608
    Top = 272
  end
