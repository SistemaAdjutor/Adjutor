  object qPedidosItemGrade: TSQLQuery
    MaxBlobSize = -1
    Params = <>
    SQL.Strings = (
      'SELECT pit.PRD_REFER REFERENCIA, '
      ' PRD.PRD_DESCRI DESCRICAO,'
      ' SUM(pit.PRF_QTDE) prf_qtde,'
      ' MIN(pit.PRF_PRECO) prf_preco,'
      ' SUM(pit.PRF_QTDE * pit.PRF_PRECO) prf_total'
      ' from ped_it01 pit'
      ' left join prd0000 prd on (pit.prd_refer = prd.prd_refer)'
      'where PIT.PED_CODIGO = '#39'000069'#39
      ' GROUP BY 1, 2'
      'ORDER BY pit.PRD_REFER')
    SQLConnection = DataCadastros.SQLConnection1
    Left = 640
    Top = 56
    object qPedidosItemGradeREFERENCIA: TStringField
      FieldName = 'REFERENCIA'
